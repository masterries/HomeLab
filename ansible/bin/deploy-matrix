#!/usr/bin/env bash
# bin/deploy-matrix -- matrix-docker-ansible-deploy (MDAD) and its checks, in one run
#
# Where it runs: on ansible-control, in ~/lab, as profile "matrix" or "matrix-setup"
# (config/run-profiles.json; ".\lab.ps1 deploy matrix" starts it after matrix-prepare.yml), with a
# run token for the policy ansible-matrix and an SSH certificate for matrix only:
#   bash bin/deploy-matrix install-all | setup-all
#
# What it does, in order (each step stops the run when it fails):
#   1. MDAD in ~/mdad through the lab's entry point lab-setup.yml (it reads the Matrix secrets from
#      OpenBao into memory first), with the tags of MDAD's "just install-all" (or "just setup-all":
#      needed after REMOVING a component from vars.yml; install-all skips uninstall tasks and is
#      2-5x faster otherwise). It installs Docker on the Matrix VM, pulls the images, writes the
#      configuration, creates the systemd units matrix-*.service and starts everything. The first
#      run takes a while (image downloads). Matrix accounts are not created here: one is created on
#      a user's first login through Keycloak.
#   2. MDAD's self-check: the client API, Element and the well-known files, with certificate
#      verification. One task prints "fatal ... 404 ... /_matrix/federation/v1/version" and is
#      marked "ignored": with federation switched off, that 404 is the expected answer.
#   3. "mas-cli doctor": checks MAS from inside its container (its view of the well-known file, of
#      Synapse and of the login API). It only REPORTS (its exit code is always 0): read its output.
#   4. playbooks/matrix-check.yml: the checks that fail the run - Traefik serves certificates from
#      OpenBao's current intermediate CA, Synapse delegates logins to MAS, and MAS sends logins to
#      Keycloak.
# Running MDAD in ~/mdad makes Ansible use MDAD's own ansible.cfg (not the lab's in ~/lab).
set -euo pipefail

recipe="${1:?usage: deploy-matrix install-all|setup-all}"
case "$recipe" in
  install-all|setup-all) ;;
  *) echo "deploy-matrix: unknown recipe $recipe" >&2; exit 2 ;;
esac

cd "$HOME/mdad"
echo "== MDAD: the tags of just $recipe, through lab-setup.yml (the first run downloads Docker and the images; this takes a while) =="
ansible-playbook -i inventory/hosts lab-setup.yml "--tags=$recipe,ensure-matrix-users-created,start"
echo '== MDAD self-check =='
ansible-playbook -i inventory/hosts lab-setup.yml --tags=self-check
echo '== mas-cli doctor (reports only) =='
ansible-playbook -i inventory/hosts lab-setup.yml --tags=matrix-authentication-service-mas-cli-doctor
cd "$HOME/lab"
echo '== Checks: ACME certificates from the intermediate CA, login path to Keycloak (matrix-check.yml) =='
ansible-playbook playbooks/matrix-check.yml
