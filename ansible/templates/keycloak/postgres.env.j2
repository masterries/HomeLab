# postgres.env -- initialisation of Keycloak's PostgreSQL database
# Generated by ansible/playbooks/keycloak.yml (mode 0600, root): it contains a secret.
# The official postgres image reads these variables ONLY when its data volume is empty, i.e.
# on the very first start: it then creates the database and the user. Changing the password
# here later has no effect on the existing database (that would be "ALTER ROLE" in psql).
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD={{ vault_keycloak_db_password }}
