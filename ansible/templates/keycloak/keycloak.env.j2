# keycloak.env -- Keycloak's settings as environment variables (KC_<OPTION>)
# Generated by ansible/playbooks/keycloak.yml (mode 0600, root): it contains secrets.
# Values contain only letters and digits: Docker Compose would interpret a "$".

# Database: the "postgres" service of the same Compose project (reached by its service name).
KC_DB=postgres
KC_DB_URL_HOST=postgres
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD={{ vault_keycloak_db_password }}

# The public URL. Keycloak builds every link, redirect and the token issuer from it. Requests
# reach Keycloak unchanged (the firewall only forwards packets; there is no reverse proxy in
# front that would rewrite headers), so no proxy settings are needed.
KC_HOSTNAME={{ lab_keycloak_url }}

# One Keycloak instance: a local cache. In production mode Keycloak defaults to a clustered cache
# ("ispn") and looks for other cluster members through the database on every start, which on a
# single node only adds a delay and warnings. Enterprise equivalent (high availability): several
# Keycloak instances with KC_CACHE=ispn behind a load balancer.
KC_CACHE=local

# TLS with the certificate issued by the lab CA (PEM files, mounted read-only).
KC_HTTPS_CERTIFICATE_FILE=/opt/keycloak/conf/tls/tls.crt
KC_HTTPS_CERTIFICATE_KEY_FILE=/opt/keycloak/conf/tls/tls.key

# Health and metrics on the management port 9000, as plain HTTP (it is bound to 127.0.0.1 on
# the VM, see compose.yml); otherwise it would inherit HTTPS and the health check would fail.
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_HTTP_MANAGEMENT_SCHEME=http

# Bootstrap: on the very FIRST start (empty database) Keycloak creates an administrator for its
# admin console and a service-account client for automation (Ansible). Later starts ignore
# these values. Keycloak marks both as "temporary" in the console.
# LAB SHORTCUT: they are kept. Enterprise equivalent: create permanent, personal admin accounts
# and a dedicated automation client as code, then delete the temporary ones.
KC_BOOTSTRAP_ADMIN_USERNAME={{ lab_keycloak_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ vault_keycloak_admin_password }}
KC_BOOTSTRAP_ADMIN_CLIENT_ID={{ lab_keycloak_ansible_client_id }}
KC_BOOTSTRAP_ADMIN_CLIENT_SECRET={{ vault_keycloak_ansible_client_secret }}
