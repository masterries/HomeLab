# compose.yml -- Keycloak and its PostgreSQL database as a Docker Compose project
#
# Generated by ansible/playbooks/keycloak.yml from ansible/templates/keycloak/compose.yml.j2:
# edit the template in the repository, not this file on the VM (the next run overwrites it).
# Lives in {{ keycloak_stack_dir }} on the Keycloak VM. Useful commands there (as root):
#   docker compose ps              state and health of both containers
#   docker compose logs -f keycloak
#
# Docker Compose describes several containers, their network, volumes and start order in one
# file, and "docker compose up" brings the whole set to that state (idempotent: running
# containers that already match are left alone). Enterprise equivalent: Kubernetes with the
# Keycloak operator, or a managed identity service.
name: keycloak
services:
  postgres:
    image: "{{ keycloak_postgres_image }}"
    restart: unless-stopped
    # POSTGRES_* variables: only read when the database is created on an EMPTY volume.
    env_file: postgres.env
    volumes:
      # PostgreSQL 18 images keep their data below /var/lib/postgresql (older images used
      # .../data); mounting .../data makes the 18+ image refuse to start.
      - pgdata:/var/lib/postgresql
    healthcheck:
      # Over TCP (-h 127.0.0.1): during its first initialisation the image runs a temporary
      # server that listens only on the Unix socket; a socket check would report "healthy" too
      # early and Keycloak could start before the database accepts network connections.
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -p 5432 -U keycloak -d keycloak"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    stop_grace_period: 60s
    mem_limit: 512m
    # No "ports": only Keycloak talks to the database, over the project's private network.

  keycloak:
    image: "{{ keycloak_image }}"
    # "start" = production mode: HTTPS only, a fixed hostname is required. ("start-dev" would
    # allow plain HTTP and is meant for a developer's laptop.)
    command: ["start"]
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    env_file: keycloak.env
    ports:
      # HTTPS for everyone: your PC through the firewall (10.10.99.4:443 -> 10.10.10.40:443)
      # and the Matrix VM inside the lab. Keycloak itself listens on 8443 in the container.
      - "443:8443"
      # Health checks and metrics (management interface): only from the VM itself.
      - "127.0.0.1:9000:9000"
    volumes:
      # Folders, not single files: a renewed certificate replaces the files, and a bind mount of
      # a single file would keep showing the old one. Keycloak re-reads the certificate hourly.
      - ./tls:/opt/keycloak/conf/tls:ro
      # Extra trusted CAs for Keycloak's own outgoing HTTPS (back-channel logout to MAS).
      - ./truststores:/opt/keycloak/conf/truststores:ro
    healthcheck:
      # The image has no curl; this is the check from Keycloak's health guide, using bash's
      # /dev/tcp to send one HTTP request to the management port.
      test: ["CMD", "bash", "-c", "{ printf 'HEAD /health/ready HTTP/1.0\\r\\n\\r\\n' >&0; grep -q 'HTTP/1.0 200'; } 0<>/dev/tcp/127.0.0.1/9000"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 300s
      start_interval: 5s
    stop_grace_period: 30s
    # Java takes about 70 % of this as heap. Enough for a lab realm; see Keycloak's sizing guide.
    mem_limit: 2g

volumes:
  pgdata:
