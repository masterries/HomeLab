# Managed by playbooks/nginx.yml. Domain routing: config/nginx.json.
# The proxy holds no TLS private keys: SNI chooses a backend and TLS remains end-to-end.
user www-data;
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log warn;
include /etc/nginx/modules-enabled/*.conf;

events {
    worker_connections 1024;
}

stream {
    # Preserve management source policies even when a client uses another VIP.
    geo $lab_management_source_allowed {
        default 0;
        {{ lab_config.firewall.pcIp }}/32 1;
        {{ lab_config.labNetwork }} 1;
    }
{% for route in nginx_routes.tls %}
{% if route.vm in ['rustfs', 'firewall'] %}
    map $lab_management_source_allowed $lab_tls_route_{{ loop.index }} {
        default 127.0.0.1:9443;
        1 127.0.0.1:{{ 9500 + loop.index }};
    }
{% endif %}
{% endfor %}
    map $ssl_preread_server_name $lab_tls_backend {
        hostnames;
        default 127.0.0.1:9443;
{% for route in nginx_routes.tls %}
{% set route_index = loop.index %}
{% for name in route.names %}
        {{ lab_domain if name == '@' else name ~ '.' ~ lab_domain }} {% if route.vm in ['rustfs', 'firewall'] %}$lab_tls_route_{{ route_index }}{% elif route.proxyProtocol | default(false) %}{{ nginx_backend_addresses[route.vm] }}:{{ route.port }}{% else %}127.0.0.1:{{ 9500 + route_index }}{% endif %};
{% endfor %}
{% endfor %}
    }

    log_format lab_tls '$remote_addr [$time_local] $ssl_preread_server_name $upstream_addr '
                       '$status $bytes_sent $bytes_received $session_time';
    access_log /var/log/nginx/tls-access.log lab_tls;

    server {
        listen {{ nginx_ip }}:443;
        ssl_preread on;
        # The client address goes, as a PROXY header, only to nginx's own local listeners
        # (source policy, logs), which strip it: no backend receives PROXY metadata.
        proxy_protocol on;
        proxy_pass $lab_tls_backend;
        proxy_connect_timeout 5s;
        proxy_timeout 1h;
    }

    # Unknown or missing SNI is closed locally, without reaching any application.
    server {
        listen 127.0.0.1:9443 proxy_protocol;
        return '';
    }
{% for route in nginx_routes.tls %}
{% if not (route.proxyProtocol | default(false)) %}
    server {
        listen 127.0.0.1:{{ 9500 + loop.index }} proxy_protocol;
        set_real_ip_from 127.0.0.1;
        proxy_protocol off;
        proxy_pass {{ nginx_backend_addresses[route.vm] }}:{{ route.port }};
        proxy_connect_timeout 5s;
        proxy_timeout 1h;
    }
{% endif %}
{% endfor %}
{% for route in nginx_routes.tcp | default([]) %}
    # Plain TCP passthrough ({{ route.vm }}:{{ route.port }}), no PROXY header: the backend sees
    # nginx as the client and does not have to trust anything nginx says.
    server {
        listen {{ nginx_ip }}:{{ route.listen }};
        proxy_pass {{ nginx_backend_addresses[route.vm] }}:{{ route.port }};
        proxy_connect_timeout 5s;
        proxy_timeout 1h;
    }
{% endfor %}
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    server_tokens off;
    sendfile on;
    keepalive_timeout 65;
    access_log /var/log/nginx/access.log;

    server {
        listen {{ nginx_ip }}:80 default_server;
        server_name _;
        return 444;
    }
{% for route in nginx_routes.http %}
    server {
        listen {{ nginx_ip }}:80;
        server_name{% for name in route.names %} {{ lab_domain if name == '@' else name ~ '.' ~ lab_domain }}{% endfor %};
        client_max_body_size 0;
        location / {
            # Preserve ACME HTTP-01 challenge paths and the backend's own HTTPS redirects.
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto http;
            proxy_http_version 1.1;
            proxy_set_header Connection '';
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_connect_timeout 5s;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_pass http://{{ nginx_backend_addresses[route.vm] }}:{{ route.port }};
        }
    }
{% endfor %}
}
