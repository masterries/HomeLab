# /etc/nginx/sites-available/pki -- generated by ansible/playbooks/openbao.yml
#
# Plain HTTP on port 80 for exactly two kinds of PUBLIC files, and nothing else:
#   - certificates of the CAs (AIA, "authority information access": where a client downloads
#     the issuer of a certificate it got)
#   - revocation lists (CDP, "CRL distribution point": where a client checks whether a
#     certificate was revoked)
# Every lab certificate names these http:// URLs. They are plain HTTP on purpose (RFC 5280):
# checking a TLS certificate must not itself need TLS. The content is signed, so it needs no
# transport protection. Everything else answers 404 - in particular OpenBao's API is never
# reachable without TLS, and there are no redirects (an ACME validator would follow them).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    root /var/www;

    # The offline root: its certificate and CRL, static files (the root never comes online).
    location = /pki/root-ca.crt {
        types { }
        default_type application/pkix-cert;
    }
    location = /pki/root-ca.crl {
        types { }
        default_type application/pkix-crl;
    }

    # The intermediate in OpenBao: only the unauthenticated, read-only CA and CRL paths,
    # passed to OpenBao on the VM itself over HTTPS (verified against the lab root).
    # These answers need an unsealed OpenBao.
    location ~ ^/v1/pki_int/(issuer/[0-9a-f-]+/(der|pem|crl/der|crl/pem)|ca|ca/pem|ca_chain|crl|crl/pem)$ {
        limit_except GET { deny all; }
        proxy_pass https://127.0.0.1:8200;
        proxy_ssl_server_name on;
        proxy_ssl_name vault.{{ lab_domain }};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /usr/local/share/ca-certificates/lab-root-ca-2026.crt;
    }

    location / {
        return 404;
    }
}
