# /etc/logrotate.d/openbao -- generated by ansible/playbooks/openbao.yml
# OpenBao's file audit device never rotates its file itself, and a full disk blocks every
# request. "systemctl reload" (SIGHUP) makes OpenBao reopen the new file; it does not seal.
/var/log/openbao/audit.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0600 openbao openbao
    postrotate
        systemctl reload openbao >/dev/null 2>&1 || true
    endscript
}
