# openbao.hcl -- configuration of the OpenBao server on the vault VM
# Generated by ansible/playbooks/openbao.yml from ansible/templates/openbao/openbao.hcl.j2:
# edit the template in the repository, not this file (the next run overwrites it).
#
# OpenBao reads this file at start. "systemctl reload openbao" (SIGHUP) re-reads the TLS files,
# the log level and the audit settings; everything else needs a restart - and every restart
# seals OpenBao (it forgets its key until it is unsealed again: .\lab.ps1 unseal).

# The web UI at https://vault.{{ lab_domain }}:8200/ui/
ui = true

# The address clients are told to use (in redirects and in the ACME directory). The same name
# works from your PC (through the firewall's published address) and inside the lab.
api_addr = "{{ lab_vault_url }}"

# Integrated storage ("raft") also clusters several OpenBao nodes; with one node it still needs
# a cluster address. Loopback only: nothing outside the VM may talk to the cluster port.
cluster_addr = "https://127.0.0.1:8201"

log_level = "info"

# Data on the VM's disk, encrypted by OpenBao's barrier (its master key, protected by the
# unseal key shares). Raft supports snapshots (backups) through the API.
storage "raft" {
  path                   = "/opt/openbao/data"
  node_id                = "vault"
  performance_multiplier = 1
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  cluster_address = "127.0.0.1:8201"
  # No proxy may vouch for a client address: logins and tokens are bound to the socket's own
  # source address (the PC, ansible-control), so OpenBao is reached directly, never through
  # the central nginx ingress (config/nginx.json).
  # Certificate signed by the lab's offline root (lab.ps1 deploy vault), NOT by OpenBao itself:
  # otherwise an expired certificate could only be renewed through the server it protects.
  # (An empty tls_cert_file would also make OpenBao try Let's Encrypt.)
  tls_cert_file   = "/opt/openbao/tls/tls.crt"
  tls_key_file    = "/opt/openbao/tls/tls.key"
  tls_min_version = "tls12"
  # A renewed certificate is picked up without a restart (a restart would seal OpenBao).
  tls_auto_reload = true
  # No TLS client certificates are used; avoids browsers offering one.
  tls_disable_client_certs = true
}

# Audit log: every request and response, with secret values replaced by HMAC hashes. OpenBao
# refuses requests when it cannot write the audit log ("fail closed"), so logrotate keeps the
# file small and signals OpenBao to reopen it.
audit "file" "file" {
  description = "Audit log (secret values HMAC-hashed), rotated daily by logrotate"
  options {
    file_path = "/var/log/openbao/audit.log"
  }
}
