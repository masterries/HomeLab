# Credentials are supplied by systemd LoadCredential, never through this environment file.
RUSTFS_VOLUMES=/var/lib/rustfs/data
RUSTFS_ADDRESS=127.0.0.1:9000
RUSTFS_CONSOLE_ADDRESS=127.0.0.1:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_REGION=us-east-1
RUSTFS_TLS_PATH=/etc/rustfs/tls
RUSTFS_TLS_RELOAD_ENABLE=false
RUSTFS_TLS_KEYLOG=false
RUSTFS_TRUSTED_PROXY_NETWORKS=127.0.0.1,::1
RUSTFS_CORS_ALLOWED_ORIGINS=https://{{ rustfs_console_fqdn }}
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=https://{{ rustfs_console_fqdn }}
RUSTFS_FTP_ENABLE=false
RUSTFS_FTPS_ENABLE=false
RUSTFS_WEBDAV_ENABLE=false
RUSTFS_CHECK_UPDATE=false
RUSTFS_OBS_LOG_DIRECTORY=/var/log/rustfs
RUSTFS_OBS_LOG_ROTATION_TIME=daily
RUSTFS_OBS_LOG_KEEP_FILES=7
