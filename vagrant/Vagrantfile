# Vagrantfile - the lab VMs behind the firewall (Ubuntu 24.04 LTS on Hyper-V)
#
# WHAT THIS IS
#   Vagrant reads this file (it is Ruby code) on the Windows host every time a vagrant command
#   runs. It declares the lab's Linux VMs: base image ("box"), CPUs and RAM, which Hyper-V switch
#   each VM is connected to, and which provisioning scripts turn a fresh VM into its role.
#   Describing machines in versioned text files instead of clicking them together in a GUI is
#   called "infrastructure as code": the lab can be destroyed and rebuilt identically at any
#   time, and every change is visible in the repository.
#
# WHERE IT RUNS
#   On the Windows 10 host, read by vagrant.exe in an elevated PowerShell (the Hyper-V provider
#   needs administrator rights). The provisioning scripts referenced below are copied into the
#   VMs and run there.
#
# THE MACHINES
#   firewall         NOT in this file: an OPNsense VM (open source firewall with web GUI), built
#                    by scripts/commands/firewall.ps1 because there is no Vagrant box for OPNsense
#                    on Hyper-V. The only way from your PC into the lab: DNS for *.lab.internal,
#                    SSH jump host (bastion), port forwards to the published VMs, plus router/NAT
#                    to the internet and DHCP for the lab.
#   ansible-control  Ansible control node; all deployments are run from here
#   matrix           The Matrix stack: Synapse, MAS, Element Web, LiveKit (Docker, deployed with
#                    matrix-docker-ansible-deploy by scripts/commands/deploy.ps1)
#   keycloak         Keycloak, the identity provider (single sign-on) the Matrix logins go to
#   The names, MACs, IPs and sizes of these VMs come from config/lab.json, which the firewall
#   build reads as well (DHCP reservations, DNS names, published addresses and ports).
#
# NETWORK OVERVIEW
#
#                              Internet
#                                 |
#                 Windows NAT (Internet Connection Sharing)
#                                 |
#      Hyper-V "Default Switch"  (DHCP from Windows; new subnet after each Windows reboot)
#                                 |
#                             hn0 (WAN)
#                           +----------+   hn2 (HOST) 10.10.99.2 management (GUI, SSH, DNS)
#                           | firewall |              10.10.99.3 published: matrix
#                           | OPNsense |              10.10.99.4 published: keycloak
#                           +----------+              (switch "LabHost", shared with PC 10.10.99.1)
#                             hn1 (LAN) 10.10.10.1
#                                 |
#      Hyper-V "LabNet"  (private switch: VMs only, your PC has no adapter on it)
#            |                          |                          |
#   ansible-control 10.10.10.10   matrix 10.10.10.30        keycloak 10.10.10.40
#
# Your PC does not reach the lab VMs directly, only through the firewall. From the PC only these
# are open: SSH, the web GUI and DNS on 10.10.99.2, and the ports listed under "published" in
# config/lab.json on each published address, which the firewall forwards (DNAT) to the VM. This
# mirrors an enterprise perimeter: one hardened entry point, everything else in an internal
# network. Names: <name>.lab.internal. The firewall's DNS answers depending on who asks
# (split-horizon DNS): for published names your PC gets the published address, the lab the
# VM's own IP.
#
# HOW TO USE IT (elevated PowerShell, in the project folder)
#   .\lab.ps1 host-setup   once: LabHost network and DNS rule on your PC
#   .\lab.ps1 up           build/update everything, in the right order
#   .\lab.ps1 connect              SSH as "ansible" (default: ansible-control;
#                                          also matrix, keycloak, firewall)
#   .\lab.ps1 down               delete all VMs (or: lab.ps1 down matrix)
# Running vagrant directly in this folder works for status, ssh, halt, up, reload, provision and
# destroy of these VMs. The firewall must be running: the VMs get their address from its
# DHCP, and Vagrant reaches them through it (see proxy_command below).
#
# IDEMPOTENCY
#   This file only declares the desired state; "vagrant up" on a VM that is already running
#   changes nothing. Provisioners run on the first "vagrant up" of a new VM and again on
#   "vagrant provision" (or "up/reload --provision"). Every provisioning script of this project
#   is idempotent: it can run any number of times and always leaves the same result.
#
# STORAGE
#   Boxes, VM disks and Hyper-V files live on drive G: to keep C: free. lab.ps1 up sets
#   VAGRANT_HOME=G:\Vagrant\home, makes vagrant\.vagrant a junction to G: and moves the Hyper-V
#   configuration there with Move-VMStorage.

require "json"

# Windows 10's Hyper-V objects must stay in native Windows PowerShell. Vagrant otherwise
# prefers pwsh, where VM objects can fail its typed configuration helpers. Keep user overrides.
ENV["VAGRANT_PREFERRED_POWERSHELL"] = "powershell" if ENV["VAGRANT_PREFERRED_POWERSHELL"].to_s.empty?

# ---------------------------------------------------------------------------------------------
# Paths and constants (__dir__ is the folder of this Vagrantfile, so the paths do not depend on
# the current directory)
# ---------------------------------------------------------------------------------------------

# SSH certificates (scripts/lib/LabSsh.ps1): the lab's SSH CAs sign short-lived certificates; every
# machine trusts the CAs, not individual keys. keys/ssh holds the files the VMs need:
#   lab_user_ca.pub     the CAs a login certificate must come from (TrustedUserCAKeys)
#   known_hosts         the CAs a host certificate must come from (for ansible-control)
#   revoked_host_keys   host keys of rebuilt machines that must not be accepted any more
SSH_DIR = File.expand_path("../keys/ssh", __dir__)
# Written by lab.ps1 up; contains the jump host "firewall" (used by proxy_command below).
# It is used without quotes in the proxy command below, so the path must not contain spaces.
SSH_CONFIG = File.expand_path("../keys/ssh_config", __dir__)
# Windows' own OpenSSH client for the jump. Vagrant puts its own ssh (OpenSSH 10, an MSYS2 build)
# first in PATH, so a plain "ssh" in proxy_command would be that one; the lab is built and tested
# with Windows' ssh (the same that the scripts use).
SYSTEM_SSH = File.join(ENV.fetch("SystemRoot", "C:/Windows"), "System32", "OpenSSH", "ssh.exe").tr("\\", "/")
# The PC's SSH certificate is valid 8 hours. Vagrant logs in through the firewall with it, so
# before a command that connects to the VMs it must still be valid for a while: if it expires
# within 4 hours (or does not exist), ".\lab.ps1 ssh-cert" renews it first (it asks OpenBao, or
# uses the offline SSH CA before OpenBao is deployed). The lab.ps1 commands renew it themselves,
# so this only does something for "vagrant ..." typed by hand.
SSH_CERT_INFO = File.join(SSH_DIR, "pc_ed25519-cert.valid-until")
if %w[up provision reload ssh ssh-config halt resume].include?(ARGV.first)
  require "time"
  fresh = begin
    (Time.iso8601(File.read(SSH_CERT_INFO).split.first) - Time.now) > 4 * 3600
  rescue StandardError
    false
  end
  unless fresh
    lab = File.expand_path("../lab.ps1", __dir__)
    unless system("powershell.exe", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", lab, "ssh-cert")
      abort "The PC's SSH certificate could not be renewed (see above). Run .\\lab.ps1 up."
    end
  end
  if %w[up provision reload].include?(ARGV.first) && !File.exist?(File.join(SSH_DIR, "lab_user_ca.pub"))
    abort "keys/ssh/lab_user_ca.pub is missing: run .\\lab.ps1 up (it creates the SSH CA)."
  end
end
# Provisioning scripts shared by all lab VMs
PROVISION_DIR = File.expand_path("../provision", __dir__)
# Upload folder inside the VMs. The file provisioner copies files as the SSH user "vagrant",
# which cannot write to other users' home directories or /etc. The shell scripts (running as
# root) install the files from there to their final place and delete the uploaded copies.
SSH_STAGING = "/home/vagrant/lab-ssh"

# The lab VMs from config/lab.json, e.g.
#   { "matrix" => { mac: "02000A0A0A1E", ip: "10.10.10.30", cpus: 4, memory: 8192 } }
# (memory in MB; without cpus/memory in lab.json a VM gets 2 vCPUs and 2048 MB).
# The fixed MAC addresses make sure the firewall always gives each VM the same IP and name: a
# DHCP reservation on the firewall maps MAC -> IP and name. DHCP reservations are common in
# enterprise networks too: addresses stay stable, but they are managed in one central place
# instead of being typed into every machine.
LAB = JSON.parse(File.read(File.expand_path("../config/lab.json", __dir__)))
LAB_VMS = LAB["vms"].map { |vm|
  [vm["name"], { mac: vm["mac"], ip: vm["ip"], cpus: vm["cpus"] || 2, memory: vm["memory"] || 2048,
                 # "false" in lab.json only for VMs that hold keys in RAM (vault): see below.
                 checkpoints: vm.fetch("checkpoints", true) }]
}.to_h
LAB_SWITCH = "LabNet"

# Defines one VM with the settings that all lab VMs share; a block passed to lab_vm adds the
# machine-specific parts (provisioners).
#   switch:  Hyper-V switch for the network adapter. The Hyper-V provider cannot create
#            networks; from a "public_network" it only uses "bridge" to pick the switch.
#   mac:     fixed MAC for that adapter
#   checkpoints: false disables Hyper-V checkpoints for the VM (CheckpointType Disabled). A
#            checkpoint of a running VM writes its RAM to disk (G:, unencrypted); for vault that
#            RAM holds OpenBao's unsealed keys. Applied by Vagrant on every start of the VM.
def lab_vm(config, name, switch:, mac:, cpus: 2, memory: 2048, checkpoints: true)
  config.vm.define name do |m|
    m.vm.hostname = name
    m.vm.network "public_network", bridge: switch
    m.vm.provider "hyperv" do |h|
      # Name of the VM in Hyper-V Manager
      h.vmname = name
      h.cpus = cpus
      # RAM in MB; maxmemory = memory, so the VM never takes more host RAM than this
      h.memory = memory
      h.maxmemory = memory
      h.mac = mac
      # Linked clone: instead of copying the whole disk of the box, Vagrant creates a small
      # differencing disk that only stores the changes against the box's disk (its parent,
      # under VAGRANT_HOME). Faster to create and much smaller; the box must stay installed
      # as long as VMs are based on it.
      h.linked_clone = true
      # No nested virtualization (no hypervisor inside the VMs needed)
      h.enable_virtualization_extensions = false
      h.enable_checkpoints = checkpoints
    end
    yield m if block_given?
  end
end

Vagrant.configure("2") do |config|
  # Settings on "config" itself (outside config.vm.define) apply to every VM.
  # Provisioner order: Vagrant runs the outer provisioners first, in the order written here,
  # and then the machine-specific ones from the lab_vm blocks further down.

  # bento/ubuntu-24.04 offers no Hyper-V image, this box does.
  config.vm.box = "gusztavvargadr/ubuntu-server-2404-lts"
  # Up to 10 minutes (default: 5) for the VM to boot, report its IP and accept SSH
  config.vm.boot_timeout = 600

  # An SMB synced folder would interactively ask for Windows credentials. Files reach the VMs
  # through the file provisioner instead; the Ansible project is copied to ansible-control by
  # scripts/lib/LabRun.ps1.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # --- Provisioning shared by all VMs (runs first) -------------------------------------------
  # Only the BOOTSTRAP: what must exist before Ansible on ansible-control can reach a VM (the user
  # ansible, SSH with certificates; on ansible-control its own key and Ansible). Everything else -
  # zsh, the console autologin, the services - is configuration management with Ansible
  # (ansible/playbooks/base.yml and the deployments), run by .\lab.ps1.
  # Every provisioner has a name, so a single step can be re-run on its own, for example:
  #   vagrant provision matrix --provision-with ssh-hardening
  # "file" provisioners copy files as the SSH user "vagrant"; "shell" provisioners upload a
  # script and run it as root (via sudo).
  #
  # All VMs: user "ansible", which logs in with SSH certificates. Ansible connects to every VM
  # as this user; "vagrant" stays Vagrant's own account (with Vagrant's per-VM key).
  # The CAs a login certificate must come from. If keys/ssh does not exist yet, the upload is
  # skipped and harden-ssh.sh aborts with a hint; other vagrant commands still work.
  if File.exist?(File.join(SSH_DIR, "lab_user_ca.pub"))
    config.vm.provision "lab-ssh-ca", type: "file",
      source: File.join(SSH_DIR, "lab_user_ca.pub"), destination: "#{SSH_STAGING}/lab_user_ca.pub"
  end
  config.vm.provision "ansible-user", type: "shell",
    path: File.join(PROVISION_DIR, "bootstrap-ansible-user.sh")
  # Own SSH host keys per VM (the box ships the same keys for every VM), published to the PC
  # through Hyper-V KVP; trust in the lab's SSH CAs; certificate logins only, from the jump host
  # and ansible-control only (the addresses come from config/lab.json).
  config.vm.provision "ssh-hardening", type: "shell",
    path: File.join(PROVISION_DIR, "harden-ssh.sh"),
    args: [LAB["firewall"]["lanIp"], LAB_VMS.fetch("ansible-control")[:ip]]

  # --- the lab VMs (ansible-control, matrix, keycloak, vault) ----------------------------------
  # The lab VMs are connected only to the private LabNet. Vagrant reads their IP (10.10.10.x)
  # from Hyper-V, but your PC has no adapter in LabNet, so Vagrant reaches them through the
  # firewall as jump host (bastion), like an administrator in an enterprise network:
  # proxy_command opens an SSH connection to the firewall (as "ansible" with the PC's SSH
  # certificate, settings from keys/ssh_config, the firewall's host certificate checked), and
  # "-W %h:%p" forwards it to the VM's IP (%h) and SSH port (%p). Through this tunnel Vagrant
  # then logs in to the VM as "vagrant", with Vagrant's own per-VM key. Vagrant does not check
  # the VM's host key on that last hop; it carries no secret of the lab, and the PC never takes a
  # host key from it (the VMs publish theirs through Hyper-V, see provision/harden-ssh.sh).
  # LogLevel=ERROR keeps informational messages (such as "Permanently added ... to the list of
  # known hosts") off stderr: Windows PowerShell 5.1 can turn stderr output of native programs
  # into a terminating error when the output is redirected (e.g. lab.ps1 up *> log).
  LAB_VMS.each do |name, vm|
    lab_vm(config, name, switch: LAB_SWITCH, mac: vm[:mac], cpus: vm[:cpus], memory: vm[:memory],
           checkpoints: vm[:checkpoints]) do |m|
      m.ssh.proxy_command = "#{SYSTEM_SSH} -F #{SSH_CONFIG} -o LogLevel=ERROR -W %h:%p firewall"
      if name == "ansible-control"
        # The control VM checks the other machines' host certificates: it gets the CAs for host
        # certificates and the revocation list. Its own SSH key is made on the VM itself
        # (bootstrap-ansible-control.sh). These provisioners run after the shared ones above, so
        # the user "ansible" and its ~/.ssh already exist.
        %w[known_hosts revoked_host_keys control_ssh_config].each do |file|
          next unless File.exist?(File.join(SSH_DIR, file))
          m.vm.provision "lab-ssh-#{file.tr('_', '-')}", type: "file",
            source: File.join(SSH_DIR, file), destination: "#{SSH_STAGING}/#{file}"
        end
        m.vm.provision "ansible-control", type: "shell",
          path: File.join(PROVISION_DIR, "bootstrap-ansible-control.sh")
      end
    end
  end
end
